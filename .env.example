# Required by apps/worker for direct HTTP integration. Server-side only.
# Never expose this value through NEXT_PUBLIC_* variables.
ZHIHU_ACCESS_SECRET=

# Optional. Defaults to https://developer.zhihu.com.
ZHIHU_API_BASE_URL=

# Required by persistence-backed API and workers.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/zhihu_juejin

# Required by LLM evaluation workers. Server-side only.
DEEPSEEK_API_KEY=

# Local compatibility alias. Prefer DEEPSEEK_API_KEY in shared environments.
APIKEY=

# Optional local-only fallback that reuses the official CLI keychain credential.
ZHIHU_CLI_PATH=

# Optional server-side fallback for Zhihu column articles that the official search API only
# exposes as a truncated excerpt. Defaults to https://r.jina.ai. Set an empty value to use
# the default, or point this at a compatible Markdown reader proxy you operate.
ZHIHU_ARTICLE_READER_BASE_URL=https://r.jina.ai

# Optional current DeepSeek endpoint and model defaults.
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional API server settings.
API_HOST=127.0.0.1
API_PORT=4100
