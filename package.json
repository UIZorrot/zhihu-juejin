{
  "name": "zhihu-juejin",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun --cwd apps/web --env-file=../../.env dev",
    "dev:api": "bun --cwd apps/api dev",
    "discover": "bun --cwd apps/worker discover",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun run --filter '*' build",
    "build:cloudflare": "bun run --cwd apps/web build:cloudflare",
    "preview:cloudflare": "bun run --cwd apps/web preview:cloudflare",
    "deploy:cloudflare": "bun run --cwd apps/web deploy:cloudflare"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.11.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "7.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@opennextjs/cloudflare": "1.20.2",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2",
    "wrangler": "4.121.0"
  }
}
